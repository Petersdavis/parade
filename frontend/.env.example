# Firebase client SDK configuration.
# These are public values (safe to ship to the browser) but are kept out of
# source control so each environment can point at its own Firebase project.
# Copy to `.env.local` and fill in from the Firebase console:
#   Project settings -> General -> Your apps -> Web app -> SDK setup and config.
#
# NOTE: Next.js only exposes variables prefixed with NEXT_PUBLIC_ to the browser.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to connect the Firebase SDK to local emulators.
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false
