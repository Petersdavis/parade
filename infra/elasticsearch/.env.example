# Parade — Elasticsearch VPS environment template
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#   cp .env.example .env
#
# `.env` is git-ignored (see infra/elasticsearch/.gitignore).

# ---------------------------------------------------------------------------
# Elasticsearch bootstrap credentials
# ---------------------------------------------------------------------------
# Used only on first start to seed the keystore. Rotate immediately after the
# cluster is healthy (setup.sh does this for you).
ELASTIC_PASSWORD=change-me-before-first-boot

# ---------------------------------------------------------------------------
# WireGuard VPN (private path between Firebase Functions and the VPS)
# ---------------------------------------------------------------------------
# The VPS is the VPN server; Firebase Functions (or a small egress proxy) are
# clients. Only the VPN subnet may reach Elasticsearch.
WG_SERVER_PORT=51820
WG_SERVER_ADDRESS=10.8.0.1/24
# Public key of the client (laptop / Functions egress). Generate on the client:
#   priv=$(wg genkey); echo "$priv" > wg-client.key
#   printf '%s' "$priv" | wg pubkey
WG_CLIENT_PUBLIC_KEY=REPLACE_WITH_CLIENT_PUBLIC_KEY
# Private key of the VPS server. LEAVE THIS BLANK on first run: setup.sh will
# generate one and persist it to /etc/wireguard/wg0.key (root-only, mode 600).
# Only set it here if you want to import an existing server key. Never commit
# a real value.
WG_SERVER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Host firewall (ufw)
# ---------------------------------------------------------------------------
# Restrict SSH to your admin IP/CIDR so the VPS is not exposed on port 22 to
# the whole internet. Use your public IP with a /32, e.g. 203.0.113.7/32.
# Leave blank to allow SSH from anywhere (less secure; useful for first boot).
ADMIN_SSH_CIDR=

# ---------------------------------------------------------------------------
# Connection details consumed by Firebase Functions
# ---------------------------------------------------------------------------
# Hostname the Functions use to reach ES over the tunnel. `es.parade.internal`
# resolves to the VPN server address (10.8.0.1) via the client's DNS/hosts.
ES_NODE_URL=https://es.parade.internal:9200
ES_USERNAME=elastic
ES_PASSWORD=change-me-before-first-boot
# Path to the CA certificate that signed the ES node cert. Functions pin this
# to verify the TLS chain. Copy `certs/ca/ca.crt` to the Functions secret store.
ES_CA_CERT_PATH=./certs/ca/ca.crt

# ---------------------------------------------------------------------------
# Elasticsearch exposure mode
# ---------------------------------------------------------------------------
# Where the ES HTTP port is published on the host:
#   10.8.0.1  -> WireGuard VPN only (private; default)
#   0.0.0.0   -> public IP. Safe ONLY with mutual TLS + password auth. Use for
#                serverless clients (Firebase Functions) that cannot run a VPN.
ES_BIND_ADDRESS=10.8.0.1
# Open 9200/tcp in ufw. Set true together with ES_BIND_ADDRESS=0.0.0.0.
ES_PUBLIC_ACCESS=false

# ---------------------------------------------------------------------------
# OVHcloud VPS provisioning hints — informational only
# ---------------------------------------------------------------------------
OVH_VPS_PUBLIC_IP=51.161.103.215
OVH_DATACENTER=
OVH_VPS_MODEL=
OVH_OS=Ubuntu
OVH_NETWORK_FIREWALL_ENABLED=false
